# Application Domain
APP_DOMAIN=distribution.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# Database (PostgreSQL 16)
POSTGRES_DB=pds_production
POSTGRES_USER=pds_admin
POSTGRES_PASSWORD=generate_a_secure_password_here

# Redis / Valkey
REDIS_URL=redis://valkey:6379

# Master Encryption Key (32-byte hex for AES-256-GCM secret vault)
# Generate via: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Authentication Secret
JWT_SECRET=generate_a_random_jwt_secret_here
